# --- Site ---------------------------------------------------
PUBLIC_BASE_URL=https://awtik.ru

# Per-IP request limit for every route except /healthz.
# A normal page load fetches roughly 15–20 assets.
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW=60

# Set to true only when running behind a trusted reverse proxy
# (Nginx/Caddy), otherwise clients can spoof X-Forwarded-For and the
# per-IP rate limit will treat the proxy IP as the client.
TRUST_PROXY_HEADERS=false

# Host port for the app container. Read by docker compose, not by the app:
# inside the container uvicorn always listens on 8000.
# PORT=8000

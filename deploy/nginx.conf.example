# Example Nginx config for awtik.ru.
# Copy to /etc/nginx/sites-available/awtik.ru, adjust cert paths, enable it,
# then set TRUST_PROXY_HEADERS=true in .env and restart the app.
#
# The app listens on 127.0.0.1:8001 when run with:
#   PORT=8001 docker compose up -d --build

server {
    listen 80;
    listen [::]:80;
    server_name awtik.ru www.awtik.ru;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://awtik.ru$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name awtik.ru www.awtik.ru;

    ssl_certificate     /etc/letsencrypt/live/awtik.ru/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/awtik.ru/privkey.pem;

    # The site only serves pages and assets; there are no uploads or forms.
    client_max_body_size 16k;
    server_tokens off;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml text/plain;

    location / {
        proxy_pass http://127.0.0.1:8001;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 30s;
    }
}
